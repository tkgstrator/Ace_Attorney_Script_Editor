{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Agent",
			"Bash",
			"Bash(git push --force-if-includes:*)",
			"Bash(git push --force-with-lease:*)",
			"Cd",
			"Edit",
			"ExitPlanMode",
			"Glob",
			"Grep",
			"KillShell",
			"LSP",
			"Monitor",
			"MultiEdit",
			"NotebookEdit",
			"Read",
			"Skill",
			"TaskCreate",
			"TaskGet",
			"TaskList",
			"TaskOutput",
			"TaskStop",
			"TaskUpdate",
			"TodoWrite",
			"ToolSearch",
			"WebFetch",
			"WebSearch",
			"Write",
			"mcp__chrome-devtools__*",
			"mcp__claude_ai_Google_Drive__*",
			"mcp__context7__*",
			"mcp__github__*",
			"mcp__playwright__*",
			"mcp__plugin_github_github__*",
			"mcp__prisma__*",
			"mcp__shadcn__*",
			"mcp__tailwindcss__*",
			"mcp__terraform__*",
			"mcp__zod__*"
		],
		"deny": [
			"Bash(git clean -f:*)",
			"Bash(git clean -fd:*)",
			"Bash(git clean -fdx:*)",
			"Bash(git config --global:*)",
			"Bash(git push --force:*)",
			"Bash(git push -f:*)",
			"Bash(git reset --hard:*)",
			"Bash(npm:*)",
			"Bash(npx:*)",
			"Bash(pnpm:*)",
			"Bash(pnpx:*)",
			"Bash(rm -rf /:*)",
			"Bash(terraform apply:*)",
			"Bash(terraform destroy:*)",
			"Bash(terraform workspace delete:*)",
			"Bash(yarn:*)",
			"Edit(**/*.pem)",
			"Edit(**/.dev.vars)",
			"Edit(**/.dev.vars.development)",
			"Edit(**/.dev.vars.local)",
			"Edit(**/.dev.vars.production)",
			"Edit(**/.dev.vars.staging)",
			"Edit(**/.env)",
			"Edit(**/.env.*.local)",
			"Edit(**/.env.development)",
			"Edit(**/.env.local)",
			"Edit(**/.env.production)",
			"Edit(**/.env.staging)",
			"Edit(**/.env.test)",
			"Edit(**/.secrets)",
			"Edit(**/.secrets/**)",
			"Edit(**/private.key)",
			"Read(**/*.pem)",
			"Read(**/.dev.vars)",
			"Read(**/.dev.vars.development)",
			"Read(**/.dev.vars.local)",
			"Read(**/.dev.vars.production)",
			"Read(**/.dev.vars.staging)",
			"Read(**/.env)",
			"Read(**/.env.*.local)",
			"Read(**/.env.development)",
			"Read(**/.env.local)",
			"Read(**/.env.production)",
			"Read(**/.env.staging)",
			"Read(**/.env.test)",
			"Read(**/.secrets)",
			"Read(**/.secrets/**)",
			"Read(**/private.key)"
		],
		"defaultMode": "auto",
		"disableBypassPermissionsMode": "disable"
	},
	"model": "claude-opus-4-7",
	"enabledMcpjsonServers": ["github"],
	"alwaysThinkingEnabled": true,
	"effortLevel": "xhigh"
}
